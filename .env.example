# Тапкыч Олимп — env өзгөрмөлөрү.
# Локалдык иштетүү үчүн бул файлды backend/.env катары көчүрүңүз.

# --- Жалпы ---
NODE_ENV=development
PORT=4000

# PostgreSQL (Neon). База UTF8 болушу керек.
# DATABASE_URL — pooled туташуу (хостто "-pooler"), тиркеме ушуну колдонот.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# DIRECT_URL — түз туташуу ("-pooler" жок), Prisma миграциялары үчүн.
# Локалдык Postgres колдонсоңуз, экөөнө тең бир эле даректи жазыңыз.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- JWT ---
# Ар бири кеминде 32 белги. Генерациялоо: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Access token'дин жашоо мөөнөтү (мисалы 15m, 1h)
ACCESS_TOKEN_TTL=15m
# Refresh token'дин жашоо мөөнөтү (күн менен)
REFRESH_TOKEN_TTL_DAYS=30

# --- Коопсуздук ---
BCRYPT_ROUNDS=12
# CORS үчүн уруксат берилген домендер (үтүр менен бөлүнөт)
CORS_ORIGINS=http://localhost:5173
# Фронтенддин дареги (email шилтемелери үчүн)
APP_URL=http://localhost:5173

# --- Seed ---
# Демо аккаунттардын паролдору (README'де жазылган). Продакшнда seed'ди демо аккаунтсыз иштетиңиз.
SEED_DEMO_USERS=true
